PORT=8080

# Container/server timezone — used for Telegram alert timestamps and logs
TZ=Asia/Jakarta

ADMIN_PASSWORD=change-this-password
APP_SECRET=replace-with-at-least-32-random-characters
POLL_INTERVAL_MS=15000
UPTIME_INTERVAL_MS=30000
DB_PATH=/data/routerdeck.db
COOKIE_SECURE=false

# Optional global token override for pyruijie builds that expose api_token auth
RUIJIE_API_TOKEN=

# Ruijie Cloud rate-limit protection (optional overrides)
RUIJIE_CLOUD_CACHE_MS=120000
RUIJIE_CLOUD_STALE_MS=1800000
RUIJIE_RATE_LIMIT_BACKOFF_MS=300000
RUIJIE_INVENTORY_CACHE_SECONDS=900

# MikroTik gateway analytics server-side cache window
GATEWAY_ANALYTICS_TTL_MS=15000
